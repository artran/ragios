{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.22.0/.schema/devbox.schema.json",
  "packages": [
    "rustup@latest",
    "just@latest",
    "prek@latest"
  ],
  "shell": {
    "init_hook": [
      "(",
      "  cd \"$DEVBOX_PROJECT_ROOT\" || exit",
      "  if [ -e .git ] && ! git config --get core.hooksPath >/dev/null &&",
      "     hook_path=$(git rev-parse --git-path hooks/pre-commit) &&",
      "     [ ! -e \"$hook_path\" ] && [ ! -L \"$hook_path\" ]; then",
      "    prek install --allow-missing-config",
      "  fi",
      ")"
    ]
  }
}
